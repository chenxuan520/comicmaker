{
  "name": "comicmaker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local AI novel-to-comic studio",
  "engines": { "node": ">=22.13" },
  "packageManager": "pnpm@8.15.5",
  "bin": { "comic": "bin/comic.mjs" },
  "scripts": {
    "comic": "tsx src/cli/index.ts",
    "dev": "tsx src/cli/index.ts serve",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc -p web/tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters && tsx --test tests/architecture.test.ts",
    "test": "tsx --test tests/*.test.ts",
    "start": "node bin/comic.mjs serve"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "commander": "^14.0.0",
    "handlebars": "^4.7.8",
    "lucide-react": "^0.468.0",
    "openai": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ulid": "^3.0.0",
    "yaml": "^2.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
